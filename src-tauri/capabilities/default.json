{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "dialog:default",
    "allow-read-dir",
    "allow-stat",
    "allow-read-text",
    "allow-read-head",
    "allow-write-text",
    "allow-run-lines",
    "allow-cancel-lines",
    "allow-exec-text",
    "allow-spawn-detached",
    "allow-home-dir",
    "allow-app-data-dir",
    "allow-monitor-port",
    "allow-monitor-ping",
    "float:allow-enter",
    "float:allow-exit",
    "updater:default",
    "allow-app-version",
    "allow-check-updates",
    "allow-install-update",
    "allow-relaunch-app",
    "allow-update-tray-readout",
    "allow-set-tray-visible",
    "allow-export-archive-bundle",
    "allow-import-archive-bundle",
    "allow-remove-import-staging"
  ]
}
