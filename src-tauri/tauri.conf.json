{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC Analyzer",
  "version": "0.2.0",
  "identifier": "io.github.liang-zhenxiang.cc-analyzer",
  "build": {
    "frontendDist": "../web/dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude 会话耗时分析",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "publisher": "CC Analyzer",
    "copyright": "Copyright 2026 CC Analyzer",
    "category": "DeveloperTool",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
